# Harici veri kaynaklari icin kimlik bilgileri.
#
# KULLANIM:
#   1. Bu dosyayi ".env" adiyla kopyala
#   2. Kendi bilgilerini yaz
#   3. .env ZATEN .gitignore'da -- asla commit edilmez
#
# UYARI: Bu degerleri hicbir sohbete, issue'ya veya notebook hucresine
# yapistirma. Kod bunlari yalnizca ortam degiskeninden okur ve hicbir
# log/hata mesajinda yazdirmaz.


# --- EPIAS Seffaflik Platformu -------------------------------------------
# Kullanici adi = kayit oldugun E-POSTA adresi.
EPIAS_USERNAME=eposta@ornek.com
EPIAS_PASSWORD=buraya-sifreni-yaz


# --- NASA FIRMS (yangin sicak noktalari) ---------------------------------
# NEDEN: data/external/yanginlar.parquet 2024-12-31'de bitiyor. FIRMS'in
# YILLIK ulke arsivi 2025 ve 2026 icin YAYIMLANMADI (dogrulandi: HTTP 404).
# Bosluk yalnizca Area API ile kapatilabilir ve o da anahtar ister.
#
# NASIL ALINIR (ucretsiz, onay beklemez, kart istemez):
#   1. https://firms.modaps.eosdis.nasa.gov/api/map_key/ adresine git
#   2. E-posta adresini yaz ve gonder
#   3. Anahtar EKRANDA GORUNMEZ -- e-postana gelir (spam klasorune de bak)
#   4. Gelen karakter dizisini asagiya yapistir
#
# LIMIT: 5000 islem / 10 dakika. Cok gunluk istekler birden fazla islem
# sayilabilir (or. 7 gunluk istek). Bizim ihtiyacimiz ~240 istek, rahat sigar.
FIRMS_MAP_KEY=buraya-firms-anahtarini-yapistir
