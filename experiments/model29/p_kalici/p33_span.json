 "09_HUKUM": {
  "00_ozet": "SPAN/DEMET BAHSI OLU. Cebir SAGLAM ve zincir GECTI; olen sey ongorulen rho'nun GERCEKLESMESI.",
  "01_saf_span_skoru_sorusu": {
   "cevap": "IKISI DE DOGRU AMA FARKLI SEYLER.",
   "1.001013": "sqrt(TABAN_MSE) = sqrt(M0 - 2kL + ||r_hat||^2). L'ler GURULTUSUZ varsayilirsa cikan skor; sonda ters cevirmesinde kullanilan cebirsel SABIT budur ve dogrudur.",
   "1.001055": "sqrt(M0 - beklenen_kazanc). Buzmeli tahmincinin GERCEK kazanc beklentisi; a0+r_hat dosyasinin LB'de ALACAGI skor icin DURUST tahmin budur (kL, L gurultusunu iceren yanli bir <r,r_hat> tahminidir).",
   "fark": 4.25e-05,
   "not": "Gorevdeki '0.0005' fark yanlisti; gercek fark 4.2e-05 -- karar olceginde onemsiz. Beklenti icin 1.00106 kullanilmali.",
   "bagimsiz_dogrulama": "TABAN_MSE = 1.002026903, n19'un 1.00202690323433 degeriyle BIREBIR (m148 kodu cagrilmadan, 28 yon = 27 LB olcumu + 1 turetilmis L)."
  },
  "02_zincir": "GECTI. Sentetik r_syn -> gercek CSV yazip geri okuyarak dogrudan skor; cebir farki en fazla 2.8e-05 (esik 2e-4), rho geri cozum hatasi 1.75e-04 (esik 5e-3). m161'in donguselligi YOK: skor formulden degil diskteki dosyadan uretildi.",
  "03_c_belirsizligi_COZULDU": {
   "bulgu": "31 Agustos'ta UC GERCEK DEMET SONDASI olculmustu (D1 1.00177, D2 1.00159, Y1 1.00297) ve hicbiri |c| kestirimine islenmemisti. Bunlar TAM OLARAK bahsedilen nesnedir.",
   "olculen_rho": {
    "D1": -0.004164,
    "D2": 0.001228,
    "Y1": 0.019344
   },
   "ongorulen_rho": {
    "D1": 0.13018,
    "D2": 0.11623,
    "Y1": 0.17541
   },
   "gerceklesme_orani": {
    "D1": -0.032,
    "D2": 0.011,
    "Y1": 0.11
   },
   "yontem_notu": "rho, KAYITTAN BAGIMSIZ olarak diskteki CSV'den cozuldu: d=log1p-a0, L=(M0+Q-P^2)/2, d'nin span disi parcasi kappa, <r,d_par>=c.L_vec (hepsi olculmus). r_hat/buzme HIC kullanilmadi. m148'in kayit yoluyla farki <1e-5.",
   "yeni_c": {
    "ort": 0.058,
    "GA95": [
     -0.296,
     0.411
    ],
    "n": 3
   },
   "eski_capalarla": "0.434 (n10, yanlis nesne) ve 1.986 (seviye ekseni, n=1) HER IKISI DE dogru nesnede CURUYOR. Alti katlik belirsizlik kapandi -- ama YUKARI degil ASAGI dogru.",
   "gurultu": "rho olcum sd'si D1/D2 icin 9e-05, Y1 icin 3.7e-05. Yani bu ucu de SIFIRA yakinligi KESIN olcumler; 0.1302 ongoruden 1400 sigma uzak."
  },
